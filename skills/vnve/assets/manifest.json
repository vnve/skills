  "variants": {
    "character": {
      "默认": "神情平静，眉毛放松，嘴巴闭合。",
      "开心": "自然温暖的微笑，眼神放松明亮，脸颊略微上扬。",
      "悲伤": "神情低落，目光下垂，嘴唇略微紧绷，无眼泪。",
      "愤怒": "克制的怒意，眉头皱起，目光集中，嘴巴紧闭。",
      "惊讶": "双眼睁大，眉毛抬起，嘴巴微张。"
    },
    "background": {
      "默认": "默认时段与天气。",
      "黄昏": "日落时分，暖色低角度阳光。",
      "夜晚": "夜间环境，保留可辨识的暗部细节。",
      "雨天": "阴雨天气，室外表面湿润。",
      "闭馆后": "活动结束或营业结束后的安静空场。"
    }
  },
